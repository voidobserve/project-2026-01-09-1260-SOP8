              // 快速模式检测：使用位运算进行多数投票
              motor_status_t motor_0_status_buf_get_fast_mode(void)
              {
                  // 对于小缓冲区，可以用位图方式快速统计
                  u16 bit_map = 0;
                  
                  // 将最近几次的状态压缩到位图中
                  u8 buf_size = ARRAY_SIZE(motor_0_status_buf);
