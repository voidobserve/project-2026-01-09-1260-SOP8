   4          // timer0 用作系统定时器
   5          void timer0_init(void)
   6          {
   7   1              __EnableIRQ(TMR0_IRQn); // 使能timer0中断
   8   1              IE_EA = 1;                              // 使能总中断
   9   1      
  10   1              // 设置timer0的计数功能，配置一个频率为的中断
  11   1              TMR_ALLCON = TMR0_CNT_CLR(0x1);                                                           // 清除计数值
  12   1              TMR0_PRH = TMR_PERIOD_VAL_H((TIMER0_PEROID_VAL >> 8) & 0xFF); // 周期值
  13   1              TMR0_PRL = TMR_PERIOD_VAL_L((TIMER0_PEROID_VAL >> 0) & 0xFF);
  14   1              TMR0_CONH = TMR_PRD_PND(0x1) | TMR_PRD_IRQ_EN(0x1);                                                      // 计数等于周期时允许发生中断
  15   1              TMR0_CONL = TMR_SOURCE_SEL(0x7) | TMR_PRESCALE_SEL(0x0) | TMR_MODE_SEL(0x1); // 选择系统时钟，128�
             -��频，计数模式
  16   1      }
