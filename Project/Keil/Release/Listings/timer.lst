  18          /*  ---------------------  定时中断服务函数 ---------------------- */
  19          
  20          void TIMR0_IRQHandler(void) interrupt TMR0_IRQn
  21          {
  22   1              // 进入中断设置IP，不可删除
  23   1              __IRQnIPnPush(TMR0_IRQn);
  24   1      
  25   1              // ---------------- 用户函数处理 -------------------
  26   1      
  27   1              // 周期中断
  28   1              if (TMR0_CONH & TMR_PRD_PND(0x1))
  29   1              {
  30   2                      TMR0_CONH |= TMR_PRD_PND(0x1); // 清除pending
  31   2      
  32   2                      task_schedule_tick();
  33   2              }
  34   1      
  35   1              // 退出中断设置IP，不可删除
  36   1              __IRQnIPnPop(TMR0_IRQn);
  37   1      }


