   5          
   6          // timer0 用作系统定时器
   7          void timer0_init(void)
   8          {
   9   1              __EnableIRQ(TMR0_IRQn); // 使能timer0中断
  10   1              IE_EA = 1;                              // 使能总中断
  11   1      
  12   1              // 设置timer0的计数功能，配置一个频率为的中断
  13   1              TMR_ALLCON = TMR0_CNT_CLR(0x1);                                                           // 清除计数值
  14   1              TMR0_PRH = TMR_PERIOD_VAL_H((TIMER0_PEROID_VAL >> 8) & 0xFF); // 周期值
  15   1              TMR0_PRL = TMR_PERIOD_VAL_L((TIMER0_PEROID_VAL >> 0) & 0xFF);
  16   1              TMR0_CONH = TMR_PRD_PND(0x1) | TMR_PRD_IRQ_EN(0x1);                                                      // 计数等于周期时允许发生中断
  17   1              TMR0_CONL = TMR_SOURCE_SEL(0x7) | TMR_PRESCALE_SEL(0x0) | TMR_MODE_SEL(0x1); // 选择系统时钟，128�
             -��频，计数模式
  18   1      }
  19          
  20          /*  ---------------------  定时中断服务函数 ---------------------- */
  21          
  22          void TIMR0_IRQHandler(void) interrupt TMR0_IRQn
  23          {
  24   1              // 进入中断设置IP，不可删除
  25   1              __IRQnIPnPush(TMR0_IRQn);
  26   1      
  27   1              // ---------------- 用户函数处理 -------------------
  28   1      
  29   1              // 周期中断
  30   1              if (TMR0_CONH & TMR_PRD_PND(0x1))
  31   1              {
  32   2                      TMR0_CONH |= TMR_PRD_PND(0x1); // 清除pending
  33   2      
  34   2                      task_schedule_tick();
  35   2      
  36   2                      adc_scan(); // 至少要间隔1ms，才调用一次
  37   2      
  38   2                      uart_data_recv_timeout_add();
  39   2              }
  40   1      
  41   1              // 退出中断设置IP，不可删除
  42   1              __IRQnIPnPop(TMR0_IRQn);
  43   1      }


