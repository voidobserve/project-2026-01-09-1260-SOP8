 228   4      
 229   4                      working_timing = 0;
 230   4                      allow_check = 1;
 231   4                      check_overCurrent_time = 0;
 232   4                  }
 233   3                  else if (motorState == MOTOR_BACKWARD)
 234   3                  {
 235   4      
