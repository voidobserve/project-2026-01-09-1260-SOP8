 277   4                      // 反向结束
 278   4                  }
 279   3              }
 280   2      
 281   2              // 回来原始位置停止工作
 282   2              if (ad1 > overCurrent)
 283   2              {
 284   3      
 285   3                  check_overCurrent_time++;
