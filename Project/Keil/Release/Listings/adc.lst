   3          void adc_init(void)
   4          {
   5   1          // ADC配置
   6   1          ADC_ACON1 &= ~(ADC_VREF_SEL(0x7) | ADC_EXREF_SEL(0x1)); // 关闭外部参考电压
   7   1          ADC_ACON1 |= ADC_VREF_SEL(0x5) |                        // 选择 4.2V 作为参考电压
   8   1                       ADC_TEN_SEL(0x3); // 关闭测试信号
   9   1      
  10   1          ADC_ACON0 = ADC_CMP_EN(0x1) |  // 打开ADC中的CMP使能信号
