 253           */
 254          void adc_scan(void)
 255          {
 256   1          if (adc0_status == ADC_STATUS_NONE || adc0_status == ADC_STATUS_SEL_GET_REVERSE)
 257   1          {
 258   2              // 切换ad通道
 259   2              adc0_sel_channel(ADC_CHANNEL_FORWARD);
 260   2              adc0_status = ADC_STATUS_SEL_GET_FORWARD_WAITING;
 261   2          }
 262   1          else if (adc0_status == ADC_STATUS_SEL_GET_FORWARD_WAITING)
 263   1          {
 264   2              // 开启转换，之后在ad中断获取ad值
 265   2              ADC_CFG0 |= 0x01 << 0; // 开启 adc0 转换
 266   2              adc0_status = ADC_STATUS_SEL_GET_FORWARD;
 267   2          }
 268   1          else if (adc0_status == ADC_STATUS_SEL_GET_FORWARD)
 269   1          {
 270   2              // 切换ad通道
 271   2              adc0_sel_channel(ADC_CHANNEL_REVERSE);
 272   2              adc0_status = ADC_STATUS_SEL_GET_REVERSE_WAITING;
 273   2          }
 274   1          else if (adc0_status == ADC_STATUS_SEL_GET_REVERSE_WAITING)
 275   1          {
 276   2              // 开启转换，之后在ad中断获取ad值
 277   2              ADC_CFG0 |= 0x01 << 0; // 开启 adc0 转换
 278   2              adc0_status = ADC_STATUS_SEL_GET_REVERSE;
 279   2          }
 280   1      
 281   1          // ===========================================================
 282   1      
 283   1          if (adc1_status == ADC_STATUS_NONE || adc1_status == ADC_STATUS_SEL_GET_REVERSE)
 284   1          {
 285   2              // 切换ad通道
 286   2              adc1_sel_channel(ADC_CHANNEL_FORWARD);
 287   2              adc1_status = ADC_STATUS_SEL_GET_FORWARD_WAITING;
 288   2          }
 289   1          else if (adc1_status == ADC_STATUS_SEL_GET_FORWARD_WAITING)
 290   1          {
 291   2              // 开启转换，之后在ad中断获取ad值
 292   2              ADC_CFG0 |= 0x01 << 1; // 开启 adc1 转换
 293   2              adc1_status = ADC_STATUS_SEL_GET_FORWARD;
 294   2          }
 295   1          else if (adc1_status == ADC_STATUS_SEL_GET_FORWARD)
 296   1          {
 297   2              // 切换ad通道
 298   2              adc1_sel_channel(ADC_CHANNEL_REVERSE);
